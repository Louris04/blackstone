            let lastFilledCap = 600.00;
            let currentTargetCap = 600.00;

            planData.forEach((item, index) => {
                const val = userInputs[`day_${item.day}`]?.profit;
                if (val !== undefined && val !== '') {
                    const prevCap = index === 0 ? 600.00 : (600.00 + cumulativeRealProfitBefore(index));
