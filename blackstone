            const remain = Math.max(0, 1042827.90 - lastFilledCap);
            document.getElementById('progress-label').innerText = `Objectif : 1 042 827,90 € (Reste : ${remain.toLocaleString('fr-FR', {minimumFractionDigits: 0})} €)`;
