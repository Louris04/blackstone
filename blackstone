        function renderCalendar() {
            const month = parseInt(document.getElementById('cal-month-select').value);
            const year = parseInt(document.getElementById('cal-year-select').value);
            const grid = document.getElementById('calendar-grid');
            grid.innerHTML = '';

            const firstDay = new Date(year, month, 1);
            const lastDay = new Date(year, month + 1, 0);
            const daysInMonth = lastDay.getDate();
            
            let startDay = firstDay.getDay() - 1;
            if (startDay === -1) startDay = 6;

            for (let i = 0; i < startDay; i++) {
                const emptyCell = document.createElement('div');
                emptyCell.className = "bg-gray-950/30 border border-gray-900 rounded-xl h-24 opacity-30";
                grid.appendChild(emptyCell);
            }

            for (let d = 1; d <= daysInMonth; d++) {
                const dateStr = `${year}-${String(month + 1).padStart(2, '0')}-${String(d).padStart(2, '0')}`;
                const currentDateObj = new Date(year, month, d);
                const dayOfWeek = currentDateObj.getDay();
                const isWeekend = (dayOfWeek === 0 || dayOfWeek === 6);

                let cellBg = "bg-gray-950/85 border-gray-800 text-gray-300";
                let contentHtml = `<span class="text-xs text-gray-500">-</span>`;

                if (isWeekend) {
                    cellBg = "bg-blue-950/40 border-blue-900/50 text-blue-400 glow-blue";
                    contentHtml = `<span class="text-xs font-bold text-blue-400 tracking-wider">INACTIF WE</span>`;
                } else {
                    const matchedPlanItem = planData.find(item => tradingDates[item.day] === dateStr);
                    if (matchedPlanItem) {
                        const dayKey = `day_${matchedPlanItem.day}`;
                        const profitVal = userInputs[dayKey]?.profit;

                        if (profitVal !== undefined && profitVal !== '' && !isNaN(profitVal)) {
                            const p = parseFloat(profitVal);
                            if (p > 0) {
                                cellBg = "bg-emerald-950/40 border-emerald-800/80 text-emerald-300 glow-green";
                                contentHtml = `<span class="text-xs font-mono font-bold text-emerald-400">+${p.toLocaleString('fr-FR', {minimumFractionDigits: 2})} €</span>`;
                            } else if (p < 0) {
                                cellBg = "bg-red-950/40 border-red-800/80 text-red-300 glow-red";
                                contentHtml = `<span class="text-xs font-mono font-bold text-red-400">${p.toLocaleString('fr-FR', {minimumFractionDigits: 2})} €</span>`;
                            } else {
                                contentHtml = `<span class="text-xs font-mono text-gray-400">0,00 €</span>`;
                            }
                        } else {
                            contentHtml = `<span class="text-[11px] text-gray-500 italic">En attente</span>`;
                        }
                    }
                }

                const cell = document.createElement('div');
                cell.className = `border rounded-xl p-2.5 flex flex-col justify-between h-24 transition ${cellBg}`;
                cell.innerHTML = `
                    <div class="flex justify-between items-center text-xs">
                        <span class="font-bold text-gray-300">${d}</span>
                        <span class="text-[9px] text-gray-400">${['1er', ...Array.from({length:30}, (_,i)=>i+2)][d-1]}</span>
                    </div>
                    <div class="text-center my-auto">
