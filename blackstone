            });

            document.getElementById('stat-current-cap').innerText = lastFilledCap.toLocaleString('fr-FR', {minimumFractionDigits: 2}) + ' €';
            
            const progressPct = Math.min(100, Math.max(0, ((lastFilledCap - 600) / (1042827.90 - 600)) * 100));
            document.getElementById('stat-progress').innerText = progressPct.toFixed(2) + '%';
            document.getElementById('progress-bar').style.width = progressPct + '%';

            const diff = lastFilledCap - currentTargetCap;
            const surplusEl = document.getElementById('stat-surplus');
            const deficitEl = document.getElementById('stat-deficit');

            if (diff >= 0) {
                surplusEl.innerText = '+' + diff.toLocaleString('fr-FR', {minimumFractionDigits: 2}) + ' €';
