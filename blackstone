        function getFilteredChartData() {
            let labels = [];
            let targets = [];
            let surplusReals = [];
            let deficitReals = [];

            if (chartFilterMode === 'all') {
                labels = ['Janvier', 'Février', 'Mars', 'Avril', 'Mai', 'Juin', 'Juillet', 'Août', 'Septembre', 'Octobre', 'Novembre', 'Décembre'];
                targets = new Array(12).fill(null);
                surplusReals = new Array(12).fill(null);
                deficitReals = new Array(12).fill(null);

                let monthlyData = {};
                planData.forEach((item, index) => {
                    const dStr = tradingDates[item.day];
                    if (dStr) {
                        const [y, m, d] = dStr.split('-').map(Number);
                        const monthIdx = m - 1;
                        targets[monthIdx] = item.targetCap;
                        const val = userInputs[`day_${item.day}`]?.profit;
                        if (val !== undefined && val !== '') {
                            let prevCap = index === 0 ? 600.00 : (600.00 + cumulativeRealProfitBefore(index));
                            let real = prevCap + parseFloat(val);
                            monthlyData[monthIdx] = { real, target: item.targetCap };
                        }
                    }
                });

                for (let i = 0; i < 12; i++) {
                    if (monthlyData[i]) {
                        if (monthlyData[i].real >= monthlyData[i].target) {
                            surplusReals[i] = monthlyData[i].real;
                        } else {
                            deficitReals[i] = monthlyData[i].real;
                        }
                    }
                }

            } else if (chartFilterMode === 'current-week') {
                labels = ['Lundi', 'Mardi', 'Mercredi', 'Jeudi', 'Vendredi'];
                const weekDays = planData.filter(d => d.week === activeWeek);
                
                let points = [];
                weekDays.forEach((item) => {
                    const globalIndex = planData.findIndex(d => d.day === item.day);
                    const target = item.targetCap;
                    const val = userInputs[`day_${item.day}`]?.profit;
                    if (val !== undefined && val !== '') {
                        let prevCap = globalIndex === 0 ? 600.00 : (600.00 + cumulativeRealProfitBefore(globalIndex));
                        let real = prevCap + parseFloat(val);
                        points.push({ target, real, isSurplus: real >= target });
                    } else {
                        points.push(null);
                    }
                });

                weekDays.forEach((item, idx) => {
                    targets.push(item.targetCap);
                    const p = points[idx];
                    if (!p) {
                        surplusReals.push(null);
                        deficitReals.push(null);
                    } else {
                        if (p.isSurplus) {
                            surplusReals.push(p.real);
                            if (idx > 0 && points[idx-1] && !points[idx-1].isSurplus) {
                                deficitReals.push(p.real);
                            } else {
                                deficitReals.push(null);
                            }
                        } else {
                            deficitReals.push(p.real);
                            if (idx > 0 && points[idx-1] && points[idx-1].isSurplus) {
                                surplusReals.push(p.real);
                            } else {
                                surplusReals.push(null);
                            }
                        }
                    }
                });

            } else if (chartFilterMode === 'month') {
                const month = parseInt(document.getElementById('cal-month-select').value);
                const year = parseInt(document.getElementById('cal-year-select').value);
                const lastDay = new Date(year, month + 1, 0).getDate();
                
                labels = Array.from({length: lastDay}, (_, i) => `${i + 1}`);
                let dayPoints = {};

                for (let d = 1; d <= lastDay; d++) {
                    const dateStr = `${year}-${String(month + 1).padStart(2, '0')}-${String(d).padStart(2, '0')}`;
                    const matched = planData.find(item => tradingDates[item.day] === dateStr);
                    if (matched) {
                        const globalIndex = planData.findIndex(item => item.day === matched.day);
                        const val = userInputs[`day_${matched.day}`]?.profit;
                        targets.push(matched.targetCap);
                        if (val !== undefined && val !== '') {
                            let prevCap = globalIndex === 0 ? 600.00 : (600.00 + cumulativeRealProfitBefore(globalIndex));
                            let real = prevCap + parseFloat(val);
                            dayPoints[d] = { real, target: matched.targetCap, isSurplus: real >= matched.targetCap };
                        } else {
                            dayPoints[d] = null;
                        }
                    } else {
                        targets.push(null);
                        dayPoints[d] = null;
                    }
                }

                let daysKeys = Object.keys(dayPoints).map(Number).sort((a,b)=>a-b);
                for (let d = 1; d <= lastDay; d++) {
                    const p = dayPoints[d];
                    if (!p) {
                        surplusReals.push(null);
                        deficitReals.push(null);
                    } else {
                        if (p.isSurplus) {
                            surplusReals.push(p.real);
                            let prevDay = daysKeys.filter(k => k < d).pop();
                            if (prevDay && dayPoints[prevDay] && !dayPoints[prevDay].isSurplus) {
                                deficitReals.push(p.real);
                            } else {
                                deficitReals.push(null);
                            }
                        } else {
                            deficitReals.push(p.real);
                            let prevDay = daysKeys.filter(k => k < d).pop();
                            if (prevDay && dayPoints[prevDay] && dayPoints[prevDay].isSurplus) {
                                surplusReals.push(p.real);
                            } else {
                                surplusReals.push(null);
                            }
                        }
                    }
                }
            }

            return { labels, targets, surplusReals, deficitReals };
        }

        function updateChartData() {
            if (!evolutionChart) return;
            const newData = getFilteredChartData();
            evolutionChart.data.labels = newData.labels;
            evolutionChart.data.datasets[0].data = newData.targets;
            evolutionChart.data.datasets[1].data = newData.surplusReals;
            evolutionChart.data.datasets[2].data = newData.deficitReals;
            evolutionChart.update();
        }

        function resetData() {
            if (confirm("Veux-tu vraiment réinitialiser toutes tes données de trading, notes, images et calendrier ?")) {
                localStorage.removeItem('trading_user_inputs_v20');
                userInputs = {};
                initApp();
            }
        }

        window.onload = function() {
            initApp();
        };
    </script>
